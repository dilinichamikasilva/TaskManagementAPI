@DemoApi_HostAddress = https://localhost:7104
@token = REPLACE_WITH_TOKEN_FROM_LOGIN_RESPONSE

### Register a new user (returns a JWT)
POST {{DemoApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Test user",
  "email": "test.user@example.com",
  "password": "Passw0rd!"
}

### Login (returns a JWT)
POST {{DemoApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test.user@example.com",
  "password": "Passw0rd!"
}

###

GET {{DemoApi_HostAddress}}/api/tasks
Accept: application/json
Authorization: Bearer {{token}}

###

POST {{DemoApi_HostAddress}}/api/tasks
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Test task",
  "description": "Testing POST",
  "dueDate": "2026-09-30",
  "projectId": 1
}

###

GET {{DemoApi_HostAddress}}/api/projects
Accept: application/json
Authorization: Bearer {{token}}

###

POST {{DemoApi_HostAddress}}/api/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Test project",
  "description": "Testing POST"
}

###

GET {{DemoApi_HostAddress}}/api/users
Accept: application/json
Authorization: Bearer {{token}}
